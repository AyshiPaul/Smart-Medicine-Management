<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello, Ayshi 👋"
        android:textColor="@color/purple_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Take care of your health"
        android:textColor="@color/gray_text"
        android:textSize="14sp" />

    <!-- Daily Progress Summary Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Summary"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loading progress..."
            android:textColor="@color/purple_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Quick Actions Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Quick Actions"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Phase 5 Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Button to open ReminderActivity -->
        <Button
            android:id="@+id/btnOpenReminder"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/purple_primary"
            android:text="⏰ Set Alarm"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Button to open DailyProgressActivity -->
        <Button
            android:id="@+id/btnOpenProgress"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/purple_primary"
            android:text="📊 Daily Progress"
            android:textColor="@color/white"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Phase 6 Buttons (Pharmacy, Report, Settings) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Button to open PharmacyActivity -->
        <Button
            android:id="@+id/btnOpenPharmacy"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/purple_primary"
            android:text="🏥 Pharmacy"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <!-- Button to open WeeklyReportActivity -->
        <Button
            android:id="@+id/btnOpenReport"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/purple_primary"
            android:text="📈 Report"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <!-- Button to open SettingsActivity -->
        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:backgroundTint="@color/purple_primary"
            android:text="⚙️ Settings"
            android:textColor="@color/white"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>